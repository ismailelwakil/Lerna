AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_PROVIDERS=
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
VECTOR_BACKEND=chroma
CHROMA_PATH=data/chroma
ALLOW_MOCK_FALLBACK=false
ENABLE_WEB_SEARCH=true
TAVILY_API_KEY=<YOUR_TAVILY_API_KEY>
DATA_DIR=data
MAX_UPLOAD_MB=25
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=18
EVIDENCE_MIN_CONFIDENCE=0.30
TRUST_THRESHOLD=0.80
ARTIFACTS_DIR=data/artifacts
DEMO_STUDENT_ID=student-001
DEMO_STUDENT_NAME=Demo Student
DEMO_COURSE=Artificial Intelligence
DEMO_LANGUAGE=en
DEMO_LEARNING_PREFERENCE=step-by-step
