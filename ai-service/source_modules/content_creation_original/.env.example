# ============================================================
# EDUnation Content Creation Module — configuration template
# Copy to .env and fill real values. NEVER commit real secrets.
# ============================================================

# --- Module access (integration with the main EDUnation backend) ---
# The core platform calls this module with: X-API-Key: <CONTENT_API_KEY>
CONTENT_API_KEY=<YOUR_CONTENT_API_KEY>
CONTENT_ENV=dev

# --- Primary LLM (OpenRouter) ---
OPENROUTER_API_KEY=<YOUR_OPENROUTER_API_KEY>
OPENROUTER_FAST_MODEL=google/gemini-3.8-flash
OPENROUTER_REASONING_MODEL=openai/gpt-5.6-sol
OPENROUTER_CONTENT_MODEL=anthropic/claude-fable-5.1
OPENROUTER_STRUCTURED_MODEL=google/gemini-3.8-flash

# --- Optional LLM fallbacks ---
GROQ_API_KEY=<YOUR_GROQ_API_KEY>
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# --- Multimodal (Gemini: embeddings / images / video) ---
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_VIDEO_MODEL=veo-3.0-generate-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# --- Voice ---
ELEVENLABS_API_KEY=<YOUR_ELEVENLABS_API_KEY>
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
DEEPGRAM_API_KEY=<YOUR_DEEPGRAM_API_KEY>

# --- Vector database (Qdrant) ---
QDRANT_URL=
QDRANT_API_KEY=<YOUR_QDRANT_API_KEY>

# --- Asset URL signing (REQUIRED in production; stable across instances) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ASSET_SIGNING_SECRET=<YOUR_ASSET_SIGNING_SECRET>

# --- Storage (local | supabase) ---
STORAGE_PROVIDER=local
STORAGE_BUCKET=edunation-content
SUPABASE_URL=
SUPABASE_SERVICE_KEY=<YOUR_SUPABASE_SERVICE_KEY>

# --- Database / queue / observability ---
DATABASE_URL=
REDIS_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=<YOUR_LANGFUSE_SECRET_KEY>
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Malware scanning (production) ---
# none | clamav   (clamav uses the documented INSTREAM protocol; stdlib socket)
# PRODUCTION REQUIRES clamav — startup fails closed with 'none' (dev default).
MALWARE_SCANNER=none
# true → uploads are REJECTED (job fails safely) when scanning is required but
# no scanner is configured/reachable. Recommended: true in production.
REQUIRE_MALWARE_SCANNING=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# --- Limits & cost control ---
CONTENT_LLM_MODE=auto            # auto | mock (offline pipeline for tests)
MAX_UPLOAD_MB=25
MAX_QUESTIONS=50
MAX_AUDIO_CHARS=20000
MAX_VIDEO_JOBS_PER_DAY=5
RATE_LIMITS={"default":"60/60","generate":"20/60","upload":"12/60","jobs":"10/60","expensive":"4/3600"}
