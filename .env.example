# Copy to Railway Variables (do not commit real keys).
# Railway always injects PORT — do not set PORT yourself.

# --- LLM ---
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_FALLBACK_PROVIDERS=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# --- Embeddings / vector ---
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
VECTOR_BACKEND=chroma
CHROMA_PATH=ai-service/data/chroma
ALLOW_MOCK_FALLBACK=false

# --- Search ---
ENABLE_WEB_SEARCH=true
TAVILY_API_KEY=

# --- Storage ---
DATA_DIR=ai-service/data
ARTIFACTS_DIR=ai-service/data/artifacts
MAX_UPLOAD_MB=25
ACADEMIC_OS_DATA_DIR=ai-service/data
ACADEMIC_OS_TEST_MODE=false
DEFAULT_STUDENT_ID=student-001

# --- Retrieval ---
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATE_K=18
EVIDENCE_MIN_CONFIDENCE=0.30
TRUST_THRESHOLD=0.80

# --- HTTP ---
# Comma-separated frontend origins, or * during integration
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
